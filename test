import numpy as np
from linear_regression import LinearRegression

np.random.seed(42)

# Синтетика: y = 3*x1 - 2*x2 + 5 + шум
N, D = 500, 2
X = np.random.randn(N, D)
true_w = np.array([3.0, -2.0])
true_bias = 5.0
y = X @ true_w + true_bias + np.random.randn(N) * 0.3

print(f"Истинные веса: {true_w}, bias: {true_bias}\n")


def report(name, model):
    pred = model.predict(X)
    mse = np.mean((pred - y) ** 2)
    print(f"[{name}]")
    print(f"  coefficients = {model.coefficients}")
    print(f"  bias         = {model.bias:.4f}")
    print(f"  MSE          = {mse:.4f}\n")


# 1. Аналитика (classic)
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='as', ad_type='classic')
report('analytic-classic', model)

# 2. Аналитика (svd)
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='as', ad_type='svd')
report('analytic-svd', model)

# 3. Ridge аналитика (svd)
model = LinearRegression(loss='mse', regularizator='ridge', alpha=0.1)
model.fit(X, y, learning_type='as', ad_type='svd')
report('ridge-analytic-svd', model)

# 4. Full-batch GD
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='gd', n_steps=2000, lr=0.05, lr_type='constant')
report('gradient_descent', model)

# 5. GD с decay lr
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='gd', n_steps=2000, lr=0.1, lr_type='decay', decay_rate=0.01)
report('gd-decay-lr', model)

# 6. SGD
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='sgd', n_steps=5000, lr=0.01, lr_type='constant', batch_size=16)
report('sgd', model)

# 7. SAG
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='sag', n_steps=2000, lr=0.01, lr_type='constant', batch_size=8)
report('sag', model)

# 8. MAE loss + GD (sanity check other losses)
model = LinearRegression(loss='mae')
model.fit(X, y, learning_type='gd', n_steps=2000, lr=0.05, lr_type='constant')
report('mae-gd', model)

# 9. Huber loss + GD
model = LinearRegression(loss='huber', delta=1.0)
model.fit(X, y, learning_type='gd', n_steps=2000, lr=0.05, lr_type='constant')
report('huber-gd', model)

# 10. Momentum
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='mm', n_steps=2000, lr=0.05, lr_type='constant', gamma=0.9)
report('momentum', model)

# 11. Momentum с decay lr
model = LinearRegression(loss='mse')
model.fit(X, y, learning_type='mm', n_steps=2000, lr=0.1, lr_type='decay', decay_rate=0.01, gamma=0.9)
report('momentum-decay-lr', model)

print("Готово. Все веса должны быть близки к [3.0, -2.0], bias ~5.0")