import numpy as np
from linear_regression import LinearRegression
X = np.random.randn(100, 3)
y = X @ np.array([1.0, -2.0, 0.5]) + 0.1 * np.random.randn(100)

# Тестируем GD с constant lr
model1 = LinearRegression(loss='mse')
model1.fit(X, y, 
           learning_type='gd', 
           n_steps=500, 
           lr=0.1, 
           lr_type='constant')
print("GD (constant):", model1.w)

# Тестируем GD с decay lr
model2 = LinearRegression(loss='mse')
model2.fit(X, y, 
           learning_type='gd', 
           n_steps=500, 
           lr=0.1, 
           lr_type='decay', 
           decay_rate=0.01)
print("GD (decay):", model2.w)

# Тестируем SGD
model3 = LinearRegression(loss='mse')
model3.fit(X, y, 
           learning_type='sgd', 
           n_steps=500, 
           lr=0.05, 
           lr_type='constant', 
           batch_size=10)
print("SGD:", model3.w)

# Тестируем SAG
model4 = LinearRegression(loss='mse')
model4.fit(X, y, 
           learning_type='sag', 
           n_steps=5000, 
           lr=0.01, 
           lr_type='constant'
           )
print("SAG:", model4.w)

# Тестируем с регуляризацией
model5 = LinearRegression(loss='mse', regularizator='ridge', alpha=0.1)
model5.fit(X, y, 
           learning_type='gd', 
           n_steps=500, 
           lr=0.1, 
           lr_type='constant')
print("Ridge + GD:", model5.w)

# Тестируем с L1 (lasso)
model6 = LinearRegression(loss='mse', regularizator='lasso', alpha=0.01)
model6.fit(X, y, 
           learning_type='gd', 
           n_steps=500, 
           lr=0.1, 
           lr_type='constant')
print("Lasso + GD:", model6.w)
